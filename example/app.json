{
  "expo": {
    "name": "expo-ai-elements-example",
    "slug": "expo-ai-elements-example",
    "version": "1.0.0",
    "scheme": "expo-ai-elements-example",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.example.expoaielements"
    },
    "android": {
      "package": "com.example.expoaielements"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-sharing"
    ],
    "web": {
      "output": "server"
    }
  }
}